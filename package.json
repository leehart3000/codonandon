{
	"name": "codonandon",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "rm -rf .svelte-kit/cloudflare && wrangler types --check && vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "husky",
		"check": "rm -rf .svelte-kit/cloudflare && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./src/service-worker/tsconfig.json",
		"verify": "pnpm run check && pnpm run lint && pnpm run test",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"gen": "rm -rf .svelte-kit/cloudflare && wrangler types"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"playwright": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.152.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,ts,mts,svelte}": [
			"eslint --fix --no-warn-ignored",
			"prettier --write"
		],
		"*.{json,jsonc,md,yml,yaml,css,html}": "prettier --write"
	},
	"dependencies": {
		"@fontsource-variable/orbitron": "^5.3.0",
		"@sentry/svelte": "^11.8.0"
	}
}
