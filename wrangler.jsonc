{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "codonandon",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "codonandon.hartsoft.dev", "custom_domain": true },
		{ "pattern": "tetraminos.hartsoft.dev", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "codonandon",
			"database_id": "c431a9d5-3533-4b39-bc80-1e1497a1d127",
			"migrations_dir": "migrations"
		}
	]
}
