{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tetraminos",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [{ "pattern": "tetraminos.hartsoft.dev", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tetraminos",
			"database_id": "4b699df3-92a0-4460-88a9-7d89125fb4fc",
			"migrations_dir": "migrations"
		}
	]
}
